# IBKR Flex Web Service API Credentials
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# Get these from IBKR Client Portal:
# Reporting > Flex Queries > Flex Web Service Configuration
IBKR_FLEX_TOKEN=your_flex_token_here

# Flex Query ID - Configure with "Last 365 Days" to always get recent transactions
# The system will automatically skip duplicates
IBKR_QUERY_ID=your_query_id_here

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
